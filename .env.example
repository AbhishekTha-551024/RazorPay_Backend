# Razorpay API Credentials (Get these from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=RAZORPAY_WEBHOOK_SECRTE

# Firebase service account JSON for server-side Auth verification and Firestore writes.
# Store the complete one-line JSON as a Vercel environment variable; do not commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local Development Port
PORT=3000

# Optional comma-separated browser origins. Native Android requests do not need CORS.
# CORS_ALLOWED_ORIGINS=https://your-trusted-web-client.example
